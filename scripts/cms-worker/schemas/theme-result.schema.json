{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rapid Studios constrained theme proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["theme", "summary"],
  "properties": {
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bg",
        "surface",
        "text",
        "muted",
        "accent",
        "accentText",
        "headingFont",
        "bodyFont",
        "radius",
        "shadow",
        "intensity"
      ],
      "properties": {
        "bg": { "$ref": "#/$defs/color" },
        "surface": { "$ref": "#/$defs/color" },
        "text": { "$ref": "#/$defs/color" },
        "muted": { "$ref": "#/$defs/color" },
        "accent": { "$ref": "#/$defs/color" },
        "accentText": { "$ref": "#/$defs/color" },
        "headingFont": { "$ref": "#/$defs/font" },
        "bodyFont": { "$ref": "#/$defs/font" },
        "radius": {
          "type": "string",
          "pattern": "^\\d{1,3}(\\.\\d{1,2})?(px|rem|em|%)$"
        },
        "shadow": { "type": "string", "enum": ["none", "sm", "md", "lg"] },
        "intensity": { "type": "string", "enum": ["overlay", "tokens"] }
      }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^(#[0-9a-fA-F]{3}|#[0-9a-fA-F]{4}|#[0-9a-fA-F]{6}|#[0-9a-fA-F]{8}|rgb\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*\\)|rgba\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*(0|1|0?\\.\\d+)\\s*\\)|hsl\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}%\\s*,\\s*\\d{1,3}%\\s*\\)|transparent)$"
    },
    "font": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120,
      "pattern": "^[a-zA-Z0-9 ,'\\\"-]+$"
    }
  }
}

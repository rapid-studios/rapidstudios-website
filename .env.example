# Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email configuration
EMAIL_FROM="Rapid Studios <hello@mail.rapidstudios.dev>"
EMAIL_REPLY_TO=hello@rapidstudios.dev

# Internal notification recipient (where lead alerts go)
EMAIL_NOTIFY=hello@rapidstudios.dev

# ============================================================
# AI-Native Client CMS (the /studio dashboard + /api/cms/*)
# ============================================================

# Owner console master key — REQUIRED for owner login at /studio.
CMS_OWNER_KEY=change-me-to-a-long-random-string

# Signs CMS session tokens (owner + client). REQUIRED in production.
CMS_JWT_SECRET=change-me-to-another-long-random-string

# Storage backend. Production requires CMS_STORE=mongo and MONGODB_URI.
# In local development, leave unset to auto-select Mongo when MONGODB_URI is
# present, otherwise use the local filesystem (.cms-data, dev only).
CMS_STORE=
MONGODB_URI=
MONGODB_DB=rapidstudios_cms
MONGODB_COLLECTION=sites
MONGODB_OWNERS_COLLECTION=cms_owners

# Local Codex worker queue. The same secret is stored locally on Jaxon's
# computer; Codex OAuth itself never leaves that computer. Use 32+ random bytes
# and mark CMS_WORKER_KEY as Sensitive in Vercel.
CMS_WORKER_KEY=
CMS_QUEUE_NAMESPACE=development
CMS_JOB_STORE=
MONGODB_JOBS_COLLECTION=cms_jobs
MONGODB_WORKER_NONCES_COLLECTION=cms_worker_nonces
MONGODB_WORKERS_COLLECTION=cms_workers
# Signed worker requests default to a strict 120-second clock window.
# CMS_WORKER_CLOCK_SKEW_SECONDS=120

# Legacy hosted AI translator (optional). The production design/copy workflow
# uses the signed local Codex worker instead. These remain available only for
# installations that intentionally keep the older direct-provider routes.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Experimental direct publisher. Keep both values unset for this Git-managed
# production site; the local worker opens a reviewed GitHub PR and main deploys
# through Vercel.
# CMS_ENABLE_EXPERIMENTAL_PUBLISH=1
# VERCEL_TOKEN=

# Remote URL ingest is disabled in production by default. Set this exact flag
# only when owner-driven URL imports are required; SSRF/redirect/size guards
# remain enforced when it is enabled.
CMS_ALLOW_REMOTE_INGEST=

# Rendered ingest via Playwright (optional, local/worker only — NOT on Vercel).
# Set to 1 AND `npm i -D playwright && npx playwright install chromium`.
# Vercel ignores this flag and always uses the bounded plain-fetch path.
CMS_ENABLE_PLAYWRIGHT=
CMS_DATA_DIR=.cms-data

# --- Design library ----------------------------------------------------
# Templates and visual directions are built in. Model-backed proposals require
# the local worker to be online; every result still passes the CMS Guardians.
